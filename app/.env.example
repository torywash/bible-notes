# MongoDB Atlas connection string. Use the "standard" (non-SRV) format if
# your network blocks DNS SRV lookups — it needs authSource=admin and
# replicaSet explicitly included, both of which Atlas includes by default
# when you copy it from Database > Connect > Drivers.
MONGODB_URI=

# GitHub OAuth App credentials (github.com/settings/developers).
# Callback URL for local dev: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Your numeric GitHub user ID (from https://api.github.com/users/<username>).
# Sign-in is restricted to this account only — everyone else falls back to
# guest mode.
AUTH_GITHUB_OWNER_ID=

# Auth.js session encryption secret. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

AUTH_URL=http://localhost:3000
